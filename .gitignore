.env
.env.*
!.env.example
.envrc

# Editor + OS
.DS_Store
.vscode/
.idea/
*.swp

# Logs
*.log
npm-debug.log*

# Vercel CLI link state (per-directory, regenerated by `vercel link`)
.vercel

